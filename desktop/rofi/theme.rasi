* {
    background: #05070d;
    surface: #0a1020;
    raised: #111a2e;
    deep-blue: #4d6fb7;
    ice-blue: #77b6e1;
    neon-cyan: #00e5ff;
    text: #dcebff;
    muted: #6b7d95;
    success: #4dd4ac;
    warning: #f2c66d;
    critical: #ff637f;

    background-color: transparent;
    text-color: @text;
}

window {
    location: center;
    anchor: center;
    width: 44%;
    padding: 18px;
    border: 1px;
    border-color: rgba(77, 111, 183, 58%);
    border-radius: 16px;
    background-color: rgba(5, 7, 13, 96%);
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry, case-indicator ];
    spacing: 10px;
    padding: 12px 14px;
    border: 1px;
    border-color: rgba(77, 111, 183, 42%);
    border-radius: 8px;
    background-color: @raised;
}

prompt {
    text-color: @neon-cyan;
}

entry {
    placeholder: "Search…";
    placeholder-color: @muted;
    cursor-color: @neon-cyan;
    cursor-width: 2px;
}

case-indicator {
    text-color: @warning;
}

message {
    padding: 10px 12px;
    border: 1px;
    border-color: rgba(77, 111, 183, 42%);
    border-radius: 8px;
    background-color: @surface;
}

textbox {
    text-color: @text;
}

listview {
    lines: 9;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 9px 11px;
    border: 0px 0px 0px 3px;
    border-color: transparent;
    border-radius: 8px;
    background-color: transparent;
    text-color: @text;
    cursor: pointer;
    spacing: 12px;
}

element selected {
    border-color: @neon-cyan;
    background-color: @raised;
    text-color: @text;
}

element normal.active,
element alternate.active,
element selected.active {
    text-color: @success;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: @critical;
}

element-icon {
    size: 24px;
    background-color: transparent;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    highlight: bold #77b6e1;
    vertical-align: 0.5;
}
